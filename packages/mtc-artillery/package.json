{
  "name": "mtc-artillery",
  "version": "0.1.0",
  "author": "Astrid <git@astrid.email>",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/grand-hawk/artillery-calculator.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "next dev --port=8888",
    "start": "next start",
    "build:analyze": "cross-env ANALYZE=true pnpm run build:unsafe",
    "build:prod": "pnpm run lint && pnpm run build:unsafe",
    "build:unsafe": "pnpm run next:build",
    "next:build": "next build",
    "lint": "pnpm run next:lint && pnpm run eslint",
    "next:lint": "next lint",
    "eslint": "eslint .",
    "lint:fix": "pnpm run eslint --fix",
    "format": "prettier . -w",
    "fix": "pnpm run lint:fix && pnpm run format",
    "depcheck": "depcheck . --quiet --skip-missing"
  },
  "dependencies": {
    "2dec": "^1.0.7",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.4",
    "@mui/joy": "5.0.0-beta.52",
    "@mui/material": "^7.3.4",
    "@tauri-apps/api": "^2.9.1",
    "flag-icons": "^7.5.0",
    "immer": "^11.1.0",
    "merge-sx": "^3.4.0",
    "next": "^15.5.18",
    "next-intl": "^4.6.1",
    "react": "^19.2.3",
    "react-device-detect": "^2.2.3",
    "react-dom": "^19.2.3",
    "react-zoom-pan-pinch": "^3.7.0",
    "usehooks-ts": "^3.1.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.5.14",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "cross-env": "^7.0.3",
    "depcheck": "^1.4.7",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-next": "15.5.14",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "prettier": "^3.8.1",
    "prettier-eslint": "^16.4.2",
    "typescript": "^5.9.3"
  }
}

{
  "name": "mtc-artillery",
  "version": "0.1.0",
  "author": "Astrid <git@astrid.email>",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/grand-hawk/artillery-calculator.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "next dev --port=8888",
    "start": "next start",
    "build:analyze": "cross-env ANALYZE=true pnpm run build:unsafe",
    "build:prod": "pnpm run lint && pnpm run build:unsafe",
    "build:unsafe": "pnpm run convert && pnpm run next:build",
    "next:build": "next build",
    "lint": "pnpm run next:lint && pnpm run eslint",
    "next:lint": "next lint",
    "eslint": "eslint .",
    "lint:fix": "pnpm run eslint -- --fix",
    "format": "prettier . -w",
    "fix": "pnpm run eslint -- --fix && pnpm run format",
    "depcheck": "depcheck . --quiet --skip-missing",
    "convert": "node scripts/convert/index.mjs"
  },
  "dependencies": {
    "2dec": "^1.0.7",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^5.17.1",
    "@mui/joy": "5.0.0-beta.51",
    "@mui/material": "^5.16.14",
    "@tauri-apps/api": "^2.3.0",
    "flag-icons": "^7.3.2",
    "immer": "^10.1.1",
    "is-image": "^4.0.0",
    "klaw": "^4.1.0",
    "merge-sx": "^3.3.2",
    "next": "15.2.4",
    "next-intl": "^4.0.2",
    "react": "^19.1.0",
    "react-device-detect": "^2.2.3",
    "react-dom": "^19.1.0",
    "react-zoom-pan-pinch": "^3.7.0",
    "sharp": "^0.33.5",
    "stale-lru-cache": "^5.1.1",
    "strapi-rest": "^0.1.3",
    "swr": "^2.3.3",
    "usehooks-ts": "^3.1.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.2.2",
    "@types/klaw": "^3.0.6",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^18.3.5",
    "@types/stale-lru-cache": "^5.1.6",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "cross-env": "^7.0.3",
    "depcheck": "^1.4.7",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-next": "15.2.4",
    "eslint-config-prettier": "^10.1.1",
    "eslint-import-resolver-typescript": "^4.3.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.4",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "prettier": "^3.5.3",
    "prettier-eslint": "^16.3.0",
    "typescript": "^5.8.2"
  }
}
